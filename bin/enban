disk_usage() {
  if disk_ui_out; then
    disk_usage_text | disk_ui_markdown | disk_gum format --theme "${DISK_UI_HELP}"
    return 0
  fi
  disk_usage_text
}

disk_usage_text() {
  cat <<'USAGE'
enban - write, read, build and verify CD, DVD and Blu-ray discs

usage:
  enban [--drive DRIVE]               open the full-screen app on a terminal
  enban info --drive DRIVE [--json]   describe the drive and the disc in it
  enban write IMAGE --drive DRIVE     burn an image, verify it and eject
  enban read --drive DRIVE IMAGE      copy a disc to an image and its SHA-256
  enban verify --drive DRIVE [IMAGE]  check every sector, or compare with IMAGE
  enban build FOLDER IMAGE            make an image from a folder
  enban erase --drive DRIVE [--full]  blank a rewritable disc
  enban checksum IMAGE                print the MD5, SHA-1 and SHA-256 of IMAGE
  enban checksum --drive DRIVE        the same for the disc in the drive
  enban queue FILE                    write the images a queue file lists
  enban discovery --drive DRIVE       fill a blank disc with test data, read it
  enban sector IMAGE [--lba N]        show one sector as hex and text
  enban sector --drive DRIVE          the same for the disc in the drive
  enban cue CUE TRACK.wav...          write a CUE sheet for an audio CD
  enban close --drive DRIVE           close the open session, or --finalize
  enban speed --drive DRIVE N|max     set the drive's read speed
  enban region --drive DRIVE          show the DVD region, or --set N
  enban booktype --drive DRIVE [TYPE] show or set the book type of a DVD+R
  enban convert IMAGE ISO             turn a BIN/CUE, NRG, MDF or CDI into ISO
  enban label IMAGE NAME              change the volume label of an ISO image
  enban layerbreak IMAGE              find the layer break of a DVD image
  enban mount IMAGE                   attach an image read-only
  enban unmount FOLDER                detach the image mounted at FOLDER
  enban speeds                        list the write speeds enban remembers
  enban doctor                        check the tools enban needs
  enban version                       print the version
  enban help                          print this page

options:
  --drive DRIVE       the drive to read, such as /dev/sr0; else ENBAN_DRIVE
  --json              print the result of info as one JSON object, for scripts
  --speed N           write at N times, such as 8; the drive picks by default
  --verify            compare the disc after write, read or queue; the default
  --no-verify         write, read or queue without the pass that compares
  --eject             open the tray when the write ends; the default
  --no-eject          leave the disc in the drive when the write ends
  --fs LIST           file systems build writes; iso9660,joliet,udf by default
  --label NAME        the volume name build writes; the folder's by default
  --full              erase every sector instead of the start of the disc
  --sectors N         how many sectors discovery writes; all free by default
  --csv FILE          where discovery saves its read rate
  --lba N             the sector sector shows; 0 by default
  --title TEXT        the album title cue writes as CD-TEXT
  --performer TEXT    the performer cue writes as CD-TEXT
  --pregap SECONDS    the gap cue puts before each track after the first; 2
  --raw               sector shows raw 2352-byte sectors
  --finalize          close finalizes the whole disc, not only the session
  --test              write and discovery simulate the burn and write nothing
  --set N             the region, 1 to 8, that region sets
  --theme NAME        colours of the terminal interface, see notes

notes:
  info, write, read, verify, erase and the app reach the drive through
  xorriso on Linux. Reading a drive on macOS is not supported yet.

  write burns only a blank disc, asks for the drive's name before it starts,
  then reads the disc back and compares it with the image. read copies the
  readable sectors of a disc that holds data, never overwrites a file, reads
  the disc again to compare and prints the SHA-256. verify reads every sector
  of a disc that holds data, compares it with the image when one is given,
  and names the first sector that differs or cannot be read. build makes a new
  image from a folder on macOS and Linux, with ISO9660 always and Joliet and
  UDF unless --fs leaves them out. UDF on Linux needs genisoimage. erase
  blanks a rewritable disc that holds data, only after you type the drive's
  name; --full overwrites every sector and takes much longer. checksum reads
  an image or the disc once and prints its MD5, SHA-1 and SHA-256.

  A queue file lists one image per line as IMAGE, DRIVE, then optionally a
  speed or auto and a number of copies, separated by tabs or spaces; lines
  starting with # are skipped. queue asks for each drive's name once, writes
  every drive's images in order while the drives work at the same time, waits
  for a blank disc before each copy and ejects after it. ENBAN_QUEUE_WAIT sets
  how many seconds to wait for a blank disc, 600 by default.

  discovery writes a known pattern to a blank disc after you type the drive's
  name, reads it back in a hundred stretches, compares every sector and saves
  the read rate of each stretch as CSV, under the data folder unless --csv
  names a file. sector shows the 2048 bytes of one sector and decodes a
  primary volume descriptor. cue checks that every track is CD audio, 44100
  Hz, 16-bit and stereo, and that the album fits the 80 minutes of a CD-R.
  write burns a .cue as an audio CD through cdrskin.

  close, speed, region and sector --raw send MMC commands through sg_raw from
  sg3-utils; booktype runs dvd+rw-booktype and needs root; convert uses bchunk
  for BIN/CUE and iat for NRG, MDF, CDI and IMG. close, region --set and
  booktype ask for the drive's name first.

  label rewrites the ISO 9660 label, in capitals, digits and underscores,
  the Joliet label, up to 16 characters, and the UDF labels in place, with
  each UDF descriptor's checksums recomputed. It first keeps the original as
  IMAGE.bak, or the first free IMAGE.bak.N, and puts it back if a step fails.
  layerbreak picks the first DVD-Video cell start past the middle that fits
  layer 0, else the middle. mount uses hdiutil on macOS and udisksctl on
  Linux. write remembers the speed of each write made at a chosen speed, per
  disc ID and drive, in ENBAN_DATA/speeds.tsv, and uses it when no speed is
  set.

  The app draws in the terminal's alternate screen and gives the screen back
  when it ends, on q or on an interrupt. Tab and the digits switch tabs, the
  arrows move between the jobs on Home and Enter opens one, ? shows the keys,
  and q quits. On Write, Enter edits a field, space turns verify or eject on
  or off, w writes after you type the drive's name, and c cancels the write.
  On Read, Enter names the new image file, space turns verify on or off,
  r reads the disc into it, and c cancels the read. On Verify, space turns the
  image comparison on or off, Enter names the image, v verifies the disc, and
  c cancels the verify. On Build, a and f add a file or folder to the layout, x
  and n remove or rename the focused entry, Enter edits the type, label, image
  or target, b builds into the image or, after you type the drive's name,
  onto the disc, and c cancels the build. On Tools, Enter opens the focused
  tool, space picks a quick or full erase, and Escape goes back to the list.
  On Queue, a adds an image, x removes it, J and K move it, Enter sets its
  speed and copies, v turns the verify on or off, o saves the queue to a file
  and s starts it after you type each drive's name. On Discovery, Enter sets
  the sectors or the speed and t starts the test after you type the drive's
  name. On Log, f filters by level, / searches and s saves a copy; the
  session log is kept in ENBAN_DATA/logs when enban quits. On Settings, space
  and Enter change a default and save the settings file at once.

  --theme, else ENBAN_THEME, else KODOUGU_THEME picks the colours: kodougu,
  catppuccin-mocha, catppuccin-latte, dracula, nord, gruvbox, tokyo-night or
  mono. KODOUGU_ACCENT=#RRGGBB replaces only the accent, and NO_COLOR turns
  colour off.

  Defaults can live in ENBAN_CONFIG/settings, ~/.config/enban/settings by
  default, one name=value per line: write_verify, write_eject and read_verify
  take yes or no, write_speed auto or a number, build_fs a list such as
  iso9660,joliet, queue_wait seconds and theme a theme name. Options, then
  ENBAN_ variables, win over the file.

examples:
  enban --drive /dev/sr0
  enban --theme nord
  enban info --drive /dev/sr0 --json
  enban write debian.iso --drive /dev/sr0 --speed 8
  enban read --drive /dev/sr0 backup.iso
  enban verify --drive /dev/sr0 debian.iso
  enban build ~/Photos/2009 family.iso --label "Family 2009"
  enban erase --drive /dev/sr0
  enban checksum --drive /dev/sr0
  enban queue family.queue
  enban discovery --drive /dev/sr0 --speed 8
  enban sector debian.iso --lba 16
  enban cue album.cue 01.wav 02.wav --title "Trip 2024"
  enban region --drive /dev/sr0
  enban convert disc.cue disc.iso
  enban label family.iso "Family 2009"
  enban mount family.iso
  enban doctor
USAGE
}

disk_option_flag() {
  case "$1" in
  --json) DISK_JSON=y ;;
  --verify)
    DISK_WRITE_VERIFY=y
    DISK_READ_VERIFY=y
    ;;
  --no-verify)
    DISK_WRITE_VERIFY=n
    DISK_READ_VERIFY=n
    ;;
  --eject) DISK_WRITE_EJECT=y ;;
  --no-eject) DISK_WRITE_EJECT=n ;;
  --full) DISK_ERASE_FULL=y ;;
  --finalize) DISK_CLOSE_FINALIZE=y ;;
  --raw) DISK_SECTOR_RAW=y ;;
  --test) DISK_WRITE_TEST=y ;;
  *) return 1 ;;
  esac
  disk_option_seen "$1"
}

disk_option_value() {
  case "$1" in
  --speed) DISK_WRITE_SPEED="$2" ;;
  --fs) DISK_BUILD_FS="$2" ;;
  --sectors) DISK_DISCOVERY_SECTORS="$2" ;;
  --csv) DISK_DISCOVERY_CSV="$2" ;;
  --lba) DISK_SECTOR_LBA="$2" ;;
  --title) DISK_CUE_TITLE="$2" ;;
  --performer) DISK_CUE_PERFORMER="$2" ;;
  --pregap) DISK_CUE_PREGAP="$2" ;;
  --set) DISK_REGION_SET="$2" ;;
  --label) DISK_BUILD_LABEL="$2" ;;
  *) DISK_DRIVE="$2" ;;
  esac
  disk_option_seen "$1"
}

disk_option_seen() {
  case "$1" in
  --speed) DISK_SPEED_OPTION="$1" ;;
  --eject | --no-eject)
    [ -z "${DISK_WRITE_OPTION}" ] || [ "${DISK_WRITE_OPTION}" = "$1" ] || DISK_EJECT_CLASH=y
    DISK_WRITE_OPTION="$1"
    ;;
  --verify | --no-verify)
    [ -z "${DISK_VERIFY_OPTION}" ] || [ "${DISK_VERIFY_OPTION}" = "$1" ] || DISK_VERIFY_CLASH=y
    DISK_VERIFY_OPTION="$1"
    ;;
  --fs | --label) DISK_BUILD_OPTION="${DISK_BUILD_OPTION:-$1}" ;;
  --full) DISK_ERASE_OPTION="$1" ;;
  --sectors | --csv) DISK_DISCOVERY_OPTION="${DISK_DISCOVERY_OPTION:-$1}" ;;
  --lba | --raw) DISK_SECTOR_OPTION="${DISK_SECTOR_OPTION:-$1}" ;;
  --finalize) DISK_RAW_OPTION="$1:close" ;;
  --test) DISK_TEST_OPTION="$1" ;;
  --set) DISK_RAW_OPTION="$1:region" ;;
  --title | --performer | --pregap) DISK_CUE_OPTION="${DISK_CUE_OPTION:-$1}" ;;
  *) ;;
  esac
  return 0
}

disk_options() {
  DISK_VALUE_OPTIONS="--drive --speed --fs --label --sectors --csv --lba --title --performer --pregap --set"
  disk_op_room="$1"
  shift
  disk_op_left="$#"
  while [ "${disk_op_left}" -gt 0 ]; do
    disk_op_arg="$1"
    shift
    disk_op_left=$((disk_op_left - 1))
    if ! disk_cli_is_option "${disk_op_arg}"; then
      disk_option_operand "${disk_op_arg}" || return 1
      continue
    fi
    disk_cli_option "${disk_op_arg}" "${disk_op_left}" "${1:-}" || return 1
    if [ "${DISK_CLI_USED}" -eq 1 ]; then
      shift
      disk_op_left=$((disk_op_left - 1))
    fi
  done
}

disk_option_operand() {
  if [ "${disk_op_room}" -lt 1 ]; then
    disk_cli_hint "unexpected argument '$1'"
    return 1
  fi
  if [ -z "${DISK_OPERAND}" ]; then
    DISK_OPERAND="$1"
  else
    DISK_OPERAND_TWO="$1"
  fi
  DISK_OPERAND_LIST="$(printf '%s\n%s\n' "${DISK_OPERAND_LIST}" "$1" | sed '/^$/d')"
  disk_op_room=$((disk_op_room - 1))
}

disk_only_for() {
  disk_of_json=""
  [ "${DISK_JSON}" != y ] || disk_of_json=--json
  disk_option_pair "${DISK_VERIFY_CLASH}" verify || return 1
  disk_option_pair "${DISK_EJECT_CLASH}" eject || return 1
  disk_option_owner "$1" "${disk_of_json}" info info || return 1
  disk_option_owner "$1" "${DISK_SPEED_OPTION}" "write discovery" "write and discovery" || return 1
  disk_option_owner "$1" "${DISK_TEST_OPTION}" "write discovery" "write and discovery" || return 1
  disk_option_owner "$1" "${DISK_WRITE_OPTION}" write write || return 1
  disk_option_owner "$1" "${DISK_BUILD_OPTION}" build build || return 1
  disk_option_owner "$1" "${DISK_ERASE_OPTION}" erase erase || return 1
  disk_option_owner "$1" "${DISK_DISCOVERY_OPTION}" discovery discovery || return 1
  disk_option_owner "$1" "${DISK_SECTOR_OPTION}" sector sector || return 1
  disk_option_owner "$1" "${DISK_CUE_OPTION}" cue cue || return 1
  disk_option_owner "$1" "${DISK_RAW_OPTION%:*}" "${DISK_RAW_OPTION#*:}" "${DISK_RAW_OPTION#*:}" || return 1
  disk_option_owner "$1" "${DISK_VERIFY_OPTION}" "write read queue" "write, read and queue"
}

disk_option_pair() {
  [ -n "$1" ] || return 0
  disk_cli_hint "options '--$2' and '--no-$2' cannot be used together"
  return 1
}

disk_option_owner() {
  [ -n "$2" ] || return 0
  case " $3 " in
  *" $1 "*) return 0 ;;
  *) : ;;
  esac
  disk_cli_hint "option '$2' works only with $4"
  return 1
}

disk_info() {
  disk_options 0 "$@" || return 1
  disk_only_for info || return 1
  if [ -z "${DISK_DRIVE}" ]; then
    disk_cli_hint "info needs --drive"
    return 1
  fi
  disk_drive_report "${DISK_DRIVE}"
}

disk_write() {
  disk_options 1 "$@" || return 1
  disk_only_for write || return 1
  if [ -z "${DISK_OPERAND}" ]; then
    disk_cli_hint "write needs an image"
    return 1
  fi
  if [ -z "${DISK_DRIVE}" ]; then
    disk_cli_hint "write needs --drive"
    return 1
  fi
  disk_speed_ok || return 1
  DISK_WRITE_IMAGE="${DISK_OPERAND}"
  case "${DISK_WRITE_IMAGE}" in
  *.cue | *.CUE) disk_audio_run ;;
  *) disk_write_run ;;
  esac
}

disk_read() {
  disk_options 1 "$@" || return 1
  disk_only_for read || return 1
  if [ -z "${DISK_OPERAND}" ]; then
    disk_cli_hint "read needs a file to write the image to"
    return 1
  fi
  if [ -z "${DISK_DRIVE}" ]; then
    disk_cli_hint "read needs --drive"
    return 1
  fi
  DISK_READ_OUT="${DISK_OPERAND}"
  disk_read_run
}

disk_verify() {
  disk_options 1 "$@" || return 1
  disk_only_for verify || return 1
  if [ -z "${DISK_DRIVE}" ]; then
    disk_cli_hint "verify needs --drive"
    return 1
  fi
  DISK_VERIFY_IMAGE="${DISK_OPERAND}"
  disk_verify_run
}

disk_build() {
  disk_options 2 "$@" || return 1
  disk_only_for build || return 1
  if [ -z "${DISK_OPERAND_TWO}" ]; then
    disk_cli_hint "build needs a folder and an image file to create"
    return 1
  fi
  DISK_BUILD_SOURCE="${DISK_OPERAND}"
  DISK_BUILD_OUT="${DISK_OPERAND_TWO}"
  disk_build_run
}

disk_erase() {
  disk_options 0 "$@" || return 1
  disk_only_for erase || return 1
  if [ -z "${DISK_DRIVE}" ]; then
    disk_cli_hint "erase needs --drive"
    return 1
  fi
  disk_erase_run
}

disk_checksum() {
  disk_options 1 "$@" || return 1
  disk_only_for checksum || return 1
  disk_one_source checksum || return 1
  DISK_CHECKSUM_IMAGE="${DISK_OPERAND}"
  disk_checksum_run
}

disk_queue() {
  disk_options 1 "$@" || return 1
  disk_only_for queue || return 1
  if [ -z "${DISK_OPERAND}" ]; then
    disk_cli_hint "queue needs a queue file"
    return 1
  fi
  DISK_QUEUE_FILE="${DISK_OPERAND}"
  disk_queue_run
}

disk_discovery() {
  disk_options 0 "$@" || return 1
  disk_only_for discovery || return 1
  if [ -z "${DISK_DRIVE}" ]; then
    disk_cli_hint "discovery needs --drive"
    return 1
  fi
  case "${DISK_DISCOVERY_SECTORS}" in
  *[!0-9]* | 0*)
    disk_error "--sectors must be a whole number from 1, got: ${DISK_DISCOVERY_SECTORS}"
    return 1
    ;;
  *) disk_speed_ok || return 1 ;;
  esac
  disk_discovery_run
}

disk_sector() {
  disk_options 1 "$@" || return 1
  disk_only_for sector || return 1
  disk_one_source sector || return 1
  case "${DISK_SECTOR_LBA}" in
  '' | *[!0-9]*)
    disk_error "--lba must be a whole number, got: ${DISK_SECTOR_LBA}"
    return 1
    ;;
  *) DISK_SECTOR_IMAGE="${DISK_OPERAND}" ;;
  esac
  disk_sector_run
}

disk_cue() {
  disk_options 999 "$@" || return 1
  disk_only_for cue || return 1
  if [ -z "${DISK_OPERAND_TWO}" ]; then
    disk_cli_hint "cue needs a CUE file to create and at least one WAV track"
    return 1
  fi
  DISK_CUE_OUT="${DISK_OPERAND}"
  DISK_CUE_TRACKS="$(printf '%s\n' "${DISK_OPERAND_LIST}" | sed '1d')"
  disk_cue_run
}

disk_close() {
  disk_options 0 "$@" || return 1
  disk_only_for close || return 1
  disk_needs_drive close || return 1
  disk_close_run
}

disk_speed() {
  disk_options 1 "$@" || return 1
  disk_only_for speed || return 1
  disk_needs_drive speed || return 1
  if [ -z "${DISK_OPERAND}" ]; then
    disk_cli_hint "speed needs a speed, such as 4 or max"
    return 1
  fi
  case "${DISK_OPERAND}" in
  max | [1-9] | [1-9][0-9]) DISK_SPEED_WANTED="${DISK_OPERAND}" ;;
  *)
    disk_error "the speed must be a whole number of times or max, got: ${DISK_OPERAND}"
    return 1
    ;;
  esac
  disk_speed_run
}

disk_region() {
  disk_options 0 "$@" || return 1
  disk_only_for region || return 1
  disk_needs_drive region || return 1
  case "${DISK_REGION_SET}" in
  '' | [1-8]) disk_region_run ;;
  *)
    disk_error "--set takes a region from 1 to 8, got: ${DISK_REGION_SET}"
    return 1
    ;;
  esac
}

disk_booktype() {
  disk_options 1 "$@" || return 1
  disk_only_for booktype || return 1
  disk_needs_drive booktype || return 1
  case "${DISK_OPERAND}" in
  '' | dvd-rom | dvd+r | dvd+rw) DISK_BOOKTYPE="${DISK_OPERAND}" ;;
  *)
    disk_error "the book type must be dvd-rom, dvd+r or dvd+rw, got: ${DISK_OPERAND}"
    return 1
    ;;
  esac
  disk_booktype_run
}

disk_convert() {
  disk_options 2 "$@" || return 1
  disk_only_for convert || return 1
  if [ -z "${DISK_OPERAND_TWO}" ]; then
    disk_cli_hint "convert needs an image and an ISO file to create"
    return 1
  fi
  DISK_CONVERT_IN="${DISK_OPERAND}"
  DISK_CONVERT_OUT="${DISK_OPERAND_TWO}"
  disk_convert_run
}

disk_needs_drive() {
  [ -n "${DISK_DRIVE}" ] && return 0
  disk_cli_hint "$1 needs --drive"
  return 1
}

disk_one_source() {
  if [ -n "${DISK_OPERAND}" ] && [ -n "${DISK_DRIVE}" ]; then
    disk_cli_hint "$1 takes an image or --drive, not both"
    return 1
  fi
  [ -n "${DISK_OPERAND}${DISK_DRIVE}" ] && return 0
  disk_cli_hint "$1 needs an image or --drive"
  return 1
}

disk_speed_ok() {
  case "${DISK_WRITE_SPEED}" in
  *[!0-9]*)
    disk_error "--speed must be a whole number of times, such as 8, got: ${DISK_WRITE_SPEED}"
    return 1
    ;;
  *) return 0 ;;
  esac
}

disk_app_start() {
  disk_options 0 "$@" || return 1
  disk_only_for app || return 1
  disk_open
}

disk_main() {
  disk_mn_count=$#
  while [ "${disk_mn_count}" -gt 0 ]; do
    disk_mn_arg="$1"
    shift
    disk_mn_count=$((disk_mn_count - 1))
    case "${disk_mn_arg}" in
    --theme=*)
      DISK_THEME="${disk_mn_arg#--theme=}"
      continue
      ;;
    --theme)
      [ "${disk_mn_count}" -gt 0 ] || disk_main_stop "option '--theme' needs a value"
      DISK_THEME="$1"
      shift
      disk_mn_count=$((disk_mn_count - 1))
      continue
      ;;
    *) ;;
    esac
    set -- "$@" "${disk_mn_arg}"
  done
  disk_ui_setup || disk_main_fail "${DISK_UI_PROBLEM}"
  disk_route "$@"
}

disk_main_stop() {
  disk_cli_hint "$1"
  exit 1
}

disk_main_fail() {
  disk_error "$1"
  exit 1
}

disk_route() {
  case "${1:-}" in
  help | -h | --help) disk_usage ;;
  version | -V | --version) disk_cli_version ;;
  doctor) disk_doctor ;;
  info)
    shift
    disk_info "$@"
    ;;
  write)
    shift
    disk_write "$@"
    ;;
  read)
    shift
    disk_read "$@"
    ;;
  verify)
    shift
    disk_verify "$@"
    ;;
  build)
    shift
    disk_build "$@"
    ;;
  erase)
    shift
    disk_erase "$@"
    ;;
  checksum)
    shift
    disk_checksum "$@"
    ;;
  queue)
    shift
    disk_queue "$@"
    ;;
  discovery)
    shift
    disk_discovery "$@"
    ;;
  sector)
    shift
    disk_sector "$@"
    ;;
  cue)
    shift
    disk_cue "$@"
    ;;
  close | speed | region | booktype | convert | label | layerbreak | mount | unmount | speeds)
    disk_mn_command="$1"
    shift
    "disk_${disk_mn_command}" "$@"
    ;;
  '') disk_open ;;
  -*) disk_app_start "$@" ;;
  *)
    disk_cli_hint "unknown command '$1'"
    return 1
    ;;
  esac
}

disk_open() {
  if [ -t 0 ] && [ -t 1 ]; then
    disk_app_run
    return 0
  fi
  disk_cli_hint "the app needs a terminal"
  return 1
}

disk_settings_load
disk_main "$@"
