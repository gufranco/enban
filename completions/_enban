#compdef enban

_enban() {
  local -a commands
  commands=(
    'info:describe the drive and the disc in it'
    'write:burn an image, verify it and eject'
    'read:copy a disc to an image'
    'verify:check a disc, or compare it with an image'
    'build:make an image from a folder'
    'erase:blank a rewritable disc'
    'checksum:print the MD5, SHA-1 and SHA-256 of an image or disc'
    'queue:write the images a queue file lists'
    'discovery:fill a blank disc with test data and read it back'
    'sector:show one sector as hex and text'
    'cue:write a CUE sheet for an audio CD'
    'close:close the open session or the disc'
    'speed:set the read speed'
    'region:show or set the DVD region'
    'booktype:show or set the book type'
    'convert:turn an image into an ISO'
    'label:change the volume label of an ISO image'
    'layerbreak:find the layer break of a DVD image'
    'mount:attach an image read-only'
    'unmount:detach a mounted image'
    'speeds:list the remembered write speeds'
    'doctor:check the tools enban needs'
    'version:print the version'
    'help:print usage'
  )

  if (( CURRENT == 2 )) && [[ "${words[2]}" != -* ]]; then
    _describe command commands
    return
  fi

  _arguments \
    '--drive[the drive to read]:drive:_files' \
    '--json[print the result as one JSON object]' \
    '--speed[write at this many times the base speed]:speed:' \
    '--no-verify[skip the second pass that compares]' \
    '--no-eject[leave the disc in the drive]' \
    '--verify[compare the disc after the job]' \
    '--eject[open the tray when the write ends]' \
    '--fs[file systems build writes]:file systems:(iso9660,joliet,udf iso9660,joliet iso9660,udf iso9660)' \
    '--label[the volume name build writes]:label:' \
    '--full[erase every sector]' \
    '--sectors[how many sectors discovery writes]:sectors:' \
    '--csv[where discovery saves its read rate]:file:_files' \
    '--lba[the sector sector shows]:lba:' \
    '--title[the album title cue writes]:title:' \
    '--performer[the performer cue writes]:performer:' \
    '--pregap[the gap before each track]:seconds:' \
    '--raw[show raw 2352-byte sectors]' \
    '--finalize[close the whole disc]' \
    '--set[the region to set]:region:(1 2 3 4 5 6 7 8)' \
    '*:image:_files' \
    '--theme[colours of the terminal interface]:theme:(kodougu catppuccin-mocha catppuccin-latte dracula nord gruvbox tokyo-night mono)'
}

_enban "$@"
